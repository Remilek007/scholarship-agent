# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholarship_agent

# API
PORT=4000

# Discovery: comma-separated official/direct pages to crawl
DISCOVERY_DIRECT_URLS=

# Discovery: comma-separated RSS/Atom feeds
DISCOVERY_RSS_FEEDS=

# Optional generic search adapter. Leave empty to run without an API key.
DISCOVERY_SEARCH_ENDPOINT=
DISCOVERY_SEARCH_API_KEY=

# Legacy/provider-specific keys reserved for future adapters
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional AI provider
OPENAI_API_KEY=
