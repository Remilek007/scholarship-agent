{
  "version": 3,
  "strategy": "federated-hybrid",
  "description": "Broad, evidence-first scholarship discovery using metasearch, official registries, bounded crawling, extraction, deduplication, verification, and diagnostics.",
  "providers": [
    { "id": "searxng", "enabled": true, "type": "metasearch", "env": "SEARXNG_URL" },
    { "id": "native", "enabled": true, "type": "existing-provider" },
    { "id": "direct-registry", "enabled": true, "type": "official-source-registry" }
  ],
  "queryExpansion": {
    "enabled": true,
    "includeDegreeVariants": true,
    "includeFundingVariants": true,
    "includeResearchPositionVariants": true,
    "includeCountryAndNationalityVariants": true,
    "includeOfficialDomainVariants": true,
    "maxQueriesPerProfile": 36
  },
  "crawl": {
    "maxPagesPerQuery": 40,
    "maxDepth": 3,
    "concurrency": 6,
    "requestTimeoutMs": 20000,
    "followPagination": true,
    "respectRobotsTxt": true,
    "playwrightFallback": true,
    "sameDomainOnlyAfterSeed": true,
    "maxPagesPerDomain": 80
  },
  "extraction": {
    "mainText": true,
    "metadata": true,
    "fundingSignals": true,
    "deadlineSignals": true,
    "eligibilitySignals": true,
    "applicationLinks": true,
    "contactAndSupervisorSignals": true,
    "structuredData": true
  },
  "deduplication": {
    "canonicalUrl": true,
    "providerAndTitle": true,
    "titleSimilarity": true,
    "providerTitleAndDeadline": true,
    "preserveOriginalUrl": true
  },
  "diagnostics": {
    "recordQueries": true,
    "recordProviders": true,
    "recordDomains": true,
    "recordBlockedPages": true,
    "recordExtractionFailures": true,
    "recordDuplicateReasons": true,
    "recordEligibilityUncertainty": true
  }
}
